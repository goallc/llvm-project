# REQUIRES: aarch64-registered-target
# RUN: split-file %s %t
# RUN: not --crash llc -mtriple=aarch64-apple-darwin-goobj \
# RUN:   -start-after=block-placement -filetype=obj %t/inconsistent.mir -o /dev/null 2>&1 | \
# RUN:   FileCheck %s --check-prefix=INCONSISTENT
# RUN: not --crash llc -mtriple=aarch64-apple-darwin-goobj \
# RUN:   -start-after=block-placement -filetype=obj %t/disconnected-inconsistent.mir -o /dev/null 2>&1 | \
# RUN:   FileCheck %s --check-prefix=DISCONNECTED

# INCONSISTENT: LLVM ERROR: inconsistent GoObj pcsp value{{.*}}in function inconsistent
# DISCONNECTED: LLVM ERROR: inconsistent GoObj pcsp value{{.*}}in function disconnected_inconsistent

#--- inconsistent.mir
--- |
  target triple = "aarch64-apple-darwin-goobj"

  define goabiinternal void @inconsistent() {
    ret void
  }
...
---
name: inconsistent
tracksRegLiveness: true
frameInfo:
  stackSize: 16
  adjustsStack: true
  hasCalls: true
body: |
  bb.0:
    successors: %bb.1, %bb.2

    Bcc 9, %bb.1, implicit undef $nzcv
    B %bb.2

  bb.1:
    successors: %bb.3

    early-clobber $sp = frame-setup STRXpre $xzr, $sp, -16
    B %bb.3

  bb.2:
    successors: %bb.3

    B %bb.3

  bb.3:
    RET undef $lr
...

#--- disconnected-inconsistent.mir
--- |
  target triple = "aarch64-apple-darwin-goobj"

  define goabiinternal void @disconnected_inconsistent() {
    ret void
  }
...
---
name: disconnected_inconsistent
tracksRegLiveness: true
frameInfo:
  stackSize: 16
  adjustsStack: true
body: |
  bb.0:
    RET undef $lr

  bb.1:
    successors: %bb.2, %bb.3

    Bcc 9, %bb.2, implicit undef $nzcv
    B %bb.3

  bb.2:
    successors: %bb.4

    early-clobber $sp = frame-setup STRXpre $xzr, $sp, -16
    B %bb.4

  bb.3:
    successors: %bb.4

    B %bb.4

  bb.4:
    RET undef $lr
...

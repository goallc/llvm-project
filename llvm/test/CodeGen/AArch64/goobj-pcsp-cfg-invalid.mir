# REQUIRES: aarch64-registered-target
# RUN: split-file %s %t
# RUN: not --crash llc -mtriple=aarch64-apple-darwin-goobj \
# RUN:   -start-after=block-placement -filetype=obj %t/inconsistent.mir -o /dev/null 2>&1 | \
# RUN:   FileCheck %s --check-prefix=INCONSISTENT
# RUN: not --crash llc -mtriple=aarch64-apple-darwin-goobj \
# RUN:   -start-after=block-placement -filetype=obj %t/unreachable.mir -o /dev/null 2>&1 | \
# RUN:   FileCheck %s --check-prefix=UNREACHABLE

# INCONSISTENT: LLVM ERROR: inconsistent GoObj pcsp value{{.*}}in function inconsistent
# UNREACHABLE: LLVM ERROR: cannot determine GoObj pcsp value{{.*}}in function unreachable

#--- inconsistent.mir
--- |
  target triple = "aarch64-apple-darwin-goobj"

  define goabiinternal void @inconsistent() {
    ret void
  }
...
---
name: inconsistent
tracksRegLiveness: true
frameInfo:
  goABIStackArgsSize: 0
  goABIArgSize: 0
  stackSize: 16
  adjustsStack: true
  hasCalls: true
body: |
  bb.0:
    successors: %bb.1, %bb.2

    Bcc 9, %bb.1, implicit undef $nzcv
    B %bb.2

  bb.1:
    successors: %bb.3

    early-clobber $sp = frame-setup STRXpre $xzr, $sp, -16
    B %bb.3

  bb.2:
    successors: %bb.3

    B %bb.3

  bb.3:
    RET undef $lr
...

#--- unreachable.mir
--- |
  target triple = "aarch64-apple-darwin-goobj"

  define goabiinternal void @unreachable() {
    ret void
  }
...
---
name: unreachable
tracksRegLiveness: true
frameInfo:
  goABIStackArgsSize: 0
  goABIArgSize: 0
body: |
  bb.0:
    RET undef $lr

  bb.1:
    RET undef $lr
...

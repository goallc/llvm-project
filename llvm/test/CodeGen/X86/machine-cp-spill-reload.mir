    liveins: $rdi, $rsi, $rax
    MOV64mr %stack.0, 1, $noreg, 0, $noreg, killed $rdi :: (store (s64) into %stack.0)
    STATEPOINT 0, 0, 0, &callee, 2, 0, 2, 0, 2, 0, 2, 1, 1, 8, %stack.0, 0, 2, 0, 2, 1, 0, 0, csr_64, implicit-def $rsp, implicit-def $ssp :: (volatile load store (s64) on %stack.0)
    $rdi = MOV64rm %stack.0, 1, $noreg, 0, $noreg :: (load (s64) from %stack.0)
    RET64 implicit $rdi
...

# CHECK-LABEL: name: root_slot
# CHECK: $rdi = MOV64rm
# CHECK: RET64 implicit $rdi
---
name: root_slot
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 8, alignment: 8 }
body: |
  bb.0:
    liveins: $rdi, $rsi, $rax
    STATEPOINT 0, 0, 0, &callee, 2, 0, 2, 0, 2, 0, 2, 1, 1, 8, %stack.0, 0, 2, 0, 2, 1, 0, 0, csr_64, implicit-def $rsp, implicit-def $ssp :: (volatile load store (s64) on %stack.0)
    $rdi = MOV64ri 9
    MOV64mr %stack.0, 1, $noreg, 0, $noreg, killed $rdi :: (store (s64) into %stack.0)
    $rdi = MOV64rm %stack.0, 1, $noreg, 0, $noreg :: (load (s64) from %stack.0)
    RET64 implicit $rdi
...

# CHECK-LABEL: name: multiple_predecessors
# CHECK: $rdi = MOV64rm
# CHECK: RET64 implicit $rdi
---
name: multiple_predecessors
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 8, alignment: 8 }
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $rdi, $rsi
    MOV64mr %stack.0, 1, $noreg, 0, $noreg, killed $rdi :: (store (s64) into %stack.0)
    TEST64rr $rsi, $rsi, implicit-def $eflags
    JCC_1 %bb.2, 4, implicit killed $eflags
    JMP_1 %bb.1
  bb.1:
    successors: %bb.3
    $rdi = MOV64ri 9
    JMP_1 %bb.3
  bb.2:
    successors: %bb.3
    JMP_1 %bb.3
  bb.3:
    $rdi = MOV64rm %stack.0, 1, $noreg, 0, $noreg :: (load (s64) from %stack.0)
    RET64 implicit $rdi
...

# CHECK-LABEL: name: eh_pad
# CHECK: $rdi = MOV64rm
# CHECK: RET64 implicit $rdi
---
name: eh_pad
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 8, alignment: 8 }
body: |
  bb.0:
    RET64
  bb.1 (landing-pad):
    liveins: $rdi
    MOV64mr %stack.0, 1, $noreg, 0, $noreg, killed $rdi :: (store (s64) into %stack.0)
    $rdi = MOV64rm %stack.0, 1, $noreg, 0, $noreg :: (load (s64) from %stack.0)
    RET64 implicit $rdi
...

# A loop header has both an initial incoming edge and a backedge. Do not
# forward a register value from only one of them.
# CHECK-LABEL: name: loop_header
# CHECK: bb.1:
# CHECK: $rdi = MOV64rm
# CHECK: CMP64rr
---
name: loop_header
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 8, alignment: 8 }
body: |
  bb.0:
    successors: %bb.1
    liveins: $rdi
    MOV64mr %stack.0, 1, $noreg, 0, $noreg, killed $rdi :: (store (s64) into %stack.0)
    JMP_1 %bb.1
  bb.1:
    successors: %bb.1, %bb.2
    $rdi = MOV64rm %stack.0, 1, $noreg, 0, $noreg :: (load (s64) from %stack.0)
    CMP64rr $rdi, $rdi, implicit-def $eflags
    JCC_1 %bb.1, 4, implicit killed $eflags
    JMP_1 %bb.2
  bb.2:
    liveins: $rdi
    RET64 implicit $rdi
...

# A clobbering register mask must end the search even without a call opcode.
# CHECK-LABEL: name: register_mask
# CHECK: KILL
# CHECK: $rdi = MOV64rm
---
name: register_mask
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 8, alignment: 8 }
body: |
  bb.0:
    liveins: $rdi
    MOV64mr %stack.0, 1, $noreg, 0, $noreg, killed $rdi :: (store (s64) into %stack.0)
    KILL csr_64
    $rdi = MOV64rm %stack.0, 1, $noreg, 0, $noreg :: (load (s64) from %stack.0)
    RET64 implicit $rdi
...

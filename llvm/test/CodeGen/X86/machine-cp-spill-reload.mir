# RUN: llc -mtriple=x86_64 -run-pass=machine-cp -verify-machineinstrs %s -o - | FileCheck %s
# RUN: llc -mtriple=x86_64 -passes=machine-cp -verify-machineinstrs %s -o - | FileCheck %s
# CHECK-LABEL: name: single_pred
# CHECK: bb.0:
# CHECK: MOV64mr %stack.0, 1, $noreg, 0, $noreg, $rdi
# CHECK: bb.1:
# CHECK: liveins: $rdi
# CHECK-NOT: MOV64rm
# CHECK: RET64 implicit $rdi
# CHECK: bb.2:
# CHECK: $rdi = MOV64rm
# NORELOAD-LABEL: name: single_pred
# NORELOAD: bb.1:
# NORELOAD-NOT: MOV64rm
# NORELOAD: RET64 implicit $rdi
---
name: single_pred
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 8, alignment: 8 }
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $rdi, $rsi
    MOV64mr %stack.0, 1, $noreg, 0, $noreg, killed $rdi :: (store (s64) into %stack.0)
    TEST64rr killed $rsi, $rsi, implicit-def $eflags
    JCC_1 %bb.2, 4, implicit killed $eflags
    JMP_1 %bb.1
  bb.1:
    $rdi = MOV64rm %stack.0, 1, $noreg, 0, $noreg :: (load (s64) from %stack.0)
    RET64 implicit $rdi
  bb.2:
    $edi = MOV32ri 9
    $rdi = MOV64rm %stack.0, 1, $noreg, 0, $noreg :: (load (s64) from %stack.0)
    RET64 implicit $rdi
...

# CHECK-LABEL: name: same_block
# CHECK: MOV64mr %stack.0, 1, $noreg, 0, $noreg, $rdi
# CHECK-NOT: MOV64rm
# CHECK: RET64 implicit $rdi
---
name: same_block
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 8, alignment: 8 }
body: |
  bb.0:
    liveins: $rdi, $rsi, $rax
    MOV64mr %stack.0, 1, $noreg, 0, $noreg, killed $rdi :: (store (s64) into %stack.0)
    $rdi = MOV64rm %stack.0, 1, $noreg, 0, $noreg :: (load (s64) from %stack.0)
    RET64 implicit $rdi
...

# CHECK-LABEL: name: intervening_kill
# CHECK: CMP64rr $rdi, $rsi
# CHECK-NOT: MOV64rm
# CHECK: RET64 implicit $rdi
---
name: intervening_kill
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 8, alignment: 8 }
body: |
  bb.0:
    liveins: $rdi, $rsi, $rax
    MOV64mr %stack.0, 1, $noreg, 0, $noreg, $rdi :: (store (s64) into %stack.0)
    CMP64rr killed $rdi, $rsi, implicit-def dead $eflags
    $rdi = MOV64rm %stack.0, 1, $noreg, 0, $noreg :: (load (s64) from %stack.0)
    RET64 implicit $rdi
...


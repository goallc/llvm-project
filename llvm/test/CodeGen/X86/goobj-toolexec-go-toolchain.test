# This exercises a mixed Go/LLVM GoObj link through go build -toolexec. The
# dependency package contains an LLVM IR file that llvm-goobj-toolexec discovers
# from the package source directory. The IR definitions use goabiinternal and goabi0,
# so their symabis declarations and GoObj symbol ABI records come directly from
# each function's IR calling convention.

# REQUIRES: x86-registered-target

# RUN: rm -rf %t.dir %t.gocache
# RUN: cp -R %S/Inputs/goobj-toolexec-module %t.dir
# RUN: cd %t.dir && env GOCACHE=%t.gocache /home/zgy/02.golang/stablego/go1.26/bin/go build -a -ldflags=-w -toolexec llvm-goobj-toolexec -o toolexec-linked ./cmd/app
# RUN: %t.dir/toolexec-linked 2>&1 | FileCheck %s
# RUN: cd %t.dir && env GOCACHE=%t.gocache /home/zgy/02.golang/stablego/go1.26/bin/go test -ldflags=-w -toolexec llvm-goobj-toolexec -run 'TestStringEqual|TestLLVMRuntimeStack' -bench BenchmarkStringEqual -benchtime=1x -count=1 ./dep | FileCheck %s --check-prefix=BENCH

# CHECK: 123
# CHECK-NEXT: 42
# CHECK-NEXT: 60 40
# CHECK-NEXT: 4
# CHECK-NEXT: 123

# BENCH: BenchmarkStringEqualNativeDirectEqual
# BENCH: BenchmarkStringEqualNativeFuncEqual
# BENCH: BenchmarkStringEqualLLVMEqual
# BENCH: BenchmarkStringEqualNativeDirectDifferent
# BENCH: BenchmarkStringEqualNativeFuncDifferent
# BENCH: BenchmarkStringEqualLLVMDifferent
# BENCH: PASS

    %1:gr64 = COPY $rsi
    MOV64mr %0, 1, $noreg, 0, $noreg, %1 :: (store (s64) into %ir.p)
    %2:vr128 = MOVAPSrm %0, 1, $noreg, 0, $noreg :: (load (s128) from %ir.p, align 16)
    $xmm0 = COPY %2
    RET 0, $xmm0
...

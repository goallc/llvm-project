name: diamond_both
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: diamond_both
  ; CHECK: %[[LO:[0-9]+]]:vr128 = MOVQI2PQIrm %0, 1, $noreg, 0, $noreg {{.*}}(load (s64)
  ; CHECK-NEXT: %{{[0-9]+}}:vr128 = MOVHPSrm killed %[[LO]], %0, 1, $noreg, 8, $noreg {{.*}}(load (s64)
  ; UNCHANGED-LABEL: name: diamond_both
  ; UNCHANGED: %{{[0-9]+}}:vr128 = MOVUPSrm
  bb.0:
    successors: %bb.1, %bb.3
    liveins: $rdi, $rsi
    %0:gr64 = COPY $rdi
    %1:gr64 = COPY $rsi
    TEST64rr %1, %1, implicit-def $eflags
    JCC_1 %bb.1, 4, implicit $eflags
    JMP_1 %bb.3
  bb.1:
    successors: %bb.2
    MOV64mr %0, 1, $noreg, 0, $noreg, %1 :: (store (s64) into %ir.p)
    JMP_1 %bb.2
  bb.2:
    successors: %bb.5
    JMP_1 %bb.5
  bb.3:
    successors: %bb.4
    MOV64mr %0, 1, $noreg, 8, $noreg, %1 :: (store (s64) into %ir.p + 8)
    JMP_1 %bb.4
  bb.4:
    successors: %bb.5
    JMP_1 %bb.5
  bb.5:
    %2:vr128 = MOVUPSrm %0, 1, $noreg, 0, $noreg :: (load (s128) from %ir.p, align 8)
    $xmm0 = COPY %2
    RET 0, $xmm0
...

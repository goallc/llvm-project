---
name: full_store_after_half
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: full_store_after_half
  ; CHECK-NOT: MOVQI2PQIrm
  ; CHECK: %{{[0-9]+}}:vr128 = MOVUPSrm
  ; CHECK-NOT: MOVHPSrm
  ; UNCHANGED-LABEL: name: full_store_after_half
  ; UNCHANGED: %{{[0-9]+}}:vr128 = MOVUPSrm
  bb.0:
    liveins: $rdi, $rsi, $rdx
    %0:gr64 = COPY $rdi
    %1:gr64 = COPY $rsi
    MOV64mr %0, 1, $noreg, 0, $noreg, %1 :: (store (s64) into %ir.p)
    %3:vr128 = IMPLICIT_DEF
    MOVUPSmr %0, 1, $noreg, 0, $noreg, %3 :: (store (s128) into %ir.p, align 8)
    %2:vr128 = MOVUPSrm %0, 1, $noreg, 0, $noreg :: (load (s128) from %ir.p, align 8)
    $xmm0 = COPY %2
    RET 0, $xmm0
...
---
name: smaller_store_after_half
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: smaller_store_after_half
  ; CHECK-NOT: MOVQI2PQIrm
  ; CHECK: %{{[0-9]+}}:vr128 = MOVUPSrm
  ; CHECK-NOT: MOVHPSrm
  ; UNCHANGED-LABEL: name: smaller_store_after_half
  ; UNCHANGED: %{{[0-9]+}}:vr128 = MOVUPSrm
  bb.0:
    liveins: $rdi, $rsi, $rdx
    %0:gr64 = COPY $rdi
    %1:gr64 = COPY $rsi
    MOV64mr %0, 1, $noreg, 0, $noreg, %1 :: (store (s64) into %ir.p)
    MOV32mi %0, 1, $noreg, 8, $noreg, 7 :: (store (s32) into %ir.p + 8)
    %2:vr128 = MOVUPSrm %0, 1, $noreg, 0, $noreg :: (load (s128) from %ir.p, align 8)
    $xmm0 = COPY %2
    RET 0, $xmm0
...

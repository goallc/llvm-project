    %0:gr64 = COPY $rdi
    %1:gr64 = COPY $rsi
    MOV64mr %0, 1, $noreg, 0, $noreg, %1 :: (store (s64) into %ir.p)
    MOV64mr %0, 1, $noreg, 8, $noreg, %1 :: (store (s64) into %ir.p + 8)
    %2:vr128 = MOVUPSrm %0, 1, $noreg, 0, $noreg :: (load (s128) from %ir.p, align 8)
    $xmm0 = COPY %2
    RET 0, $xmm0
...
---
name: shared_vector
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: shared_vector
  ; CHECK: %[[LO:[0-9]+]]:vr128 = MOVQI2PQIrm %0, 1, $noreg, 0, $noreg {{.*}}(load (s64)
  ; CHECK-NEXT: %{{[0-9]+}}:vr128 = MOVHPSrm killed %[[LO]], %0, 1, $noreg, 8, $noreg {{.*}}(load (s64)
  ; UNCHANGED-LABEL: name: shared_vector
  ; UNCHANGED: %{{[0-9]+}}:vr128 = MOVUPSrm
  bb.0:
    liveins: $rdi, $rsi, $rdx
    %0:gr64 = COPY $rdi
    %1:gr64 = COPY $rsi
    MOV64mr %0, 1, $noreg, 0, $noreg, %1 :: (store (s64) into %ir.p)
    %2:vr128 = MOVUPSrm %0, 1, $noreg, 0, $noreg :: (load (s128) from %ir.p, align 8)
    %4:vr128 = PSHUFDri %2, 78
    %5:vr128 = PXORrr %2, %4
    MOVUPSmr %0, 1, $noreg, 32, $noreg, %2 :: (store (s128) into %ir.p + 32, align 8)
    $xmm0 = COPY %5
    RET 0, $xmm0
...
---
name: unaligned
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: unaligned
  ; CHECK: %[[LO:[0-9]+]]:vr128 = MOVQI2PQIrm %0, 1, $noreg, 1, $noreg {{.*}}(load (s64)
  ; CHECK-NEXT: %{{[0-9]+}}:vr128 = MOVHPSrm killed %[[LO]], %0, 1, $noreg, 9, $noreg {{.*}}(load (s64)
  ; UNCHANGED-LABEL: name: unaligned
  ; UNCHANGED: %{{[0-9]+}}:vr128 = MOVUPSrm
  bb.0:
    liveins: $rdi, $rsi, $rdx
    %0:gr64 = COPY $rdi
    %1:gr64 = COPY $rsi
    MOV64mr %0, 1, $noreg, 1, $noreg, %1 :: (store (s64) into %ir.p + 1)
    %2:vr128 = MOVUPSrm %0, 1, $noreg, 1, $noreg :: (load (s128) from %ir.p + 1, align 1)
    $xmm0 = COPY %2
    RET 0, $xmm0
...
---

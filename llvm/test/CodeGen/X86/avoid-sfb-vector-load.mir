name: other_address
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: other_address
  ; CHECK-NOT: MOVQI2PQIrm
  ; CHECK: %{{[0-9]+}}:vr128 = MOVUPSrm
  ; CHECK-NOT: MOVHPSrm
  ; UNCHANGED-LABEL: name: other_address
  ; UNCHANGED: %{{[0-9]+}}:vr128 = MOVUPSrm
  bb.0:
    liveins: $rdi, $rsi, $rdx
    %0:gr64 = COPY $rdi
    %1:gr64 = COPY $rsi
    %3:gr64 = COPY $rdx
    MOV64mr %0, 1, $noreg, 0, $noreg, %1 :: (store (s64) into %ir.p)
    %2:vr128 = MOVUPSrm %3, 1, $noreg, 0, $noreg :: (load (s128) from %ir.q, align 8)
    $xmm0 = COPY %2
    RET 0, $xmm0
...
---

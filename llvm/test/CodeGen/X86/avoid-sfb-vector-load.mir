# RUN: llc -mtriple=x86_64 -run-pass=x86-avoid-sfb -verify-machineinstrs %s -o - | FileCheck %s --enable-var-scope
# RUN: llc -mtriple=x86_64 -passes=x86-avoid-sfb -verify-machineinstrs %s -o - | FileCheck %s --enable-var-scope
# RUN: llc -mtriple=x86_64 -run-pass=x86-avoid-sfb -x86-disable-avoid-SFB %s -o - | FileCheck %s --check-prefix=UNCHANGED
# RUN: llc -mtriple=x86_64 -run-pass=x86-avoid-sfb -x86-sfb-inspection-limit=0 %s -o - | FileCheck %s --check-prefix=UNCHANGED

# Ordinary vector consumers need both lanes after splitting. Each incoming path
# must contain a nearby half-width store; no global vector-load policy changes.
--- |
  declare void @callee()
  define <2 x i64> @low_half(ptr %p, i64 %v, ptr %q)  { ret <2 x i64> zeroinitializer }
  define <2 x i64> @high_half(ptr %p, i64 %v, ptr %q)  { ret <2 x i64> zeroinitializer }
  define <2 x i64> @immediate_half(ptr %p, i64 %v, ptr %q)  { ret <2 x i64> zeroinitializer }
  define <2 x i64> @both_halves(ptr %p, i64 %v, ptr %q)  { ret <2 x i64> zeroinitializer }
  define <2 x i64> @shared_vector(ptr %p, i64 %v, ptr %q)  { ret <2 x i64> zeroinitializer }
  define <2 x i64> @unaligned(ptr %p, i64 %v, ptr %q)  { ret <2 x i64> zeroinitializer }
  define <2 x i64> @aligned(ptr %p, i64 %v, ptr %q)  { ret <2 x i64> zeroinitializer }
  define <2 x i64> @kill_base(ptr %p, i64 %v, ptr %q)  { ret <2 x i64> zeroinitializer }
  define <2 x i64> @negative_displacement(ptr %p, i64 %v, ptr %q)  { ret <2 x i64> zeroinitializer }
  define <2 x i64> @avx_half(ptr %p, i64 %v, ptr %q) "target-features"="+avx" { ret <2 x i64> zeroinitializer }
  define <2 x i64> @avx_integer(ptr %p, i64 %v, ptr %q) "target-features"="+avx" { ret <2 x i64> zeroinitializer }
  define <2 x i64> @no_store(ptr %p, i64 %v, ptr %q)  { ret <2 x i64> zeroinitializer }
  define <2 x i64> @other_address(ptr %p, i64 %v, ptr %q)  { ret <2 x i64> zeroinitializer }
  define <2 x i64> @nonoverlap(ptr %p, i64 %v, ptr %q)  { ret <2 x i64> zeroinitializer }
  define <2 x i64> @negative_nonoverlap(ptr %p, i64 %v, ptr %q)  { ret <2 x i64> zeroinitializer }
  define <2 x i64> @byte_store(ptr %p, i64 %v, ptr %q)  { ret <2 x i64> zeroinitializer }
  define <2 x i64> @dword_store(ptr %p, i64 %v, ptr %q)  { ret <2 x i64> zeroinitializer }
  define <2 x i64> @cross_half_store(ptr %p, i64 %v, ptr %q)  { ret <2 x i64> zeroinitializer }
  define <2 x i64> @full_store_after_half(ptr %p, i64 %v, ptr %q)  { ret <2 x i64> zeroinitializer }
  define <2 x i64> @smaller_store_after_half(ptr %p, i64 %v, ptr %q)  { ret <2 x i64> zeroinitializer }
  define <2 x i64> @volatile_load(ptr %p, i64 %v, ptr %q)  { ret <2 x i64> zeroinitializer }
  define <2 x i64> @atomic_load(ptr %p, i64 %v, ptr %q)  { ret <2 x i64> zeroinitializer }
  define <2 x i64> @volatile_store(ptr %p, i64 %v, ptr %q)  { ret <2 x i64> zeroinitializer }
  define <2 x i64> @atomic_store(ptr %p, i64 %v, ptr %q)  { ret <2 x i64> zeroinitializer }
  define <2 x i64> @unknown_load_mmo(ptr %p, i64 %v, ptr %q)  { ret <2 x i64> zeroinitializer }
  define <2 x i64> @indexed_load(ptr %p, i64 %v, ptr %q)  { ret <2 x i64> zeroinitializer }
  define <2 x i64> @optsize(ptr %p, i64 %v, ptr %q) optsize { ret <2 x i64> zeroinitializer }
  define <2 x i64> @minsize(ptr %p, i64 %v, ptr %q) minsize { ret <2 x i64> zeroinitializer }
  define <2 x i64> @no_sse2(ptr %p, i64 %v, ptr %q) "target-features"="-sse2" { ret <2 x i64> zeroinitializer }
  define <2 x i64> @too_far(ptr %p, i64 %v, ptr %q)  { ret <2 x i64> zeroinitializer }
  define <2 x i64> @at_limit(ptr %p, i64 %v, ptr %q)  { ret <2 x i64> zeroinitializer }
  define <2 x i64> @call_barrier(ptr %p, i64 %v, ptr %q)  { ret <2 x i64> zeroinitializer }
  define <2 x i64> @diamond_both(ptr %p, i64 %v, ptr %q)  { ret <2 x i64> zeroinitializer }
  define <2 x i64> @diamond_one(ptr %p, i64 %v, ptr %q)  { ret <2 x i64> zeroinitializer }
  define <2 x i64> @loop_without_store(ptr %p, i64 %v, ptr %q)  { ret <2 x i64> zeroinitializer }
  define <2 x i64> @frame_slot(i64 %v) { ret <2 x i64> zeroinitializer }
...
---
name: low_half
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: low_half
  ; CHECK: %[[LO:[0-9]+]]:vr128 = MOVQI2PQIrm %0, 1, $noreg, 0, $noreg {{.*}}(load (s64)
  ; CHECK-NEXT: %{{[0-9]+}}:vr128 = MOVHPSrm killed %[[LO]], %0, 1, $noreg, 8, $noreg {{.*}}(load (s64)
  ; UNCHANGED-LABEL: name: low_half
  ; UNCHANGED: %{{[0-9]+}}:vr128 = MOVUPSrm
  bb.0:
    liveins: $rdi, $rsi, $rdx
    %0:gr64 = COPY $rdi
    %1:gr64 = COPY $rsi
    MOV64mr %0, 1, $noreg, 0, $noreg, %1 :: (store (s64) into %ir.p)
    %2:vr128 = MOVUPSrm %0, 1, $noreg, 0, $noreg :: (load (s128) from %ir.p, align 8)
    $xmm0 = COPY %2
    RET 0, $xmm0
...
---
name: high_half
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: high_half
  ; CHECK: %[[LO:[0-9]+]]:vr128 = MOVQI2PQIrm %0, 1, $noreg, 0, $noreg {{.*}}(load (s64)
  ; CHECK-NEXT: %{{[0-9]+}}:vr128 = MOVHPSrm killed %[[LO]], %0, 1, $noreg, 8, $noreg {{.*}}(load (s64)
  ; UNCHANGED-LABEL: name: high_half
  ; UNCHANGED: %{{[0-9]+}}:vr128 = MOVUPSrm
  bb.0:
    liveins: $rdi, $rsi, $rdx
    %0:gr64 = COPY $rdi
    %1:gr64 = COPY $rsi
    MOV64mr %0, 1, $noreg, 8, $noreg, %1 :: (store (s64) into %ir.p + 8)
    %2:vr128 = MOVUPSrm %0, 1, $noreg, 0, $noreg :: (load (s128) from %ir.p, align 8)
    $xmm0 = COPY %2
    RET 0, $xmm0
...
---
name: immediate_half
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: immediate_half
  ; CHECK: %[[LO:[0-9]+]]:vr128 = MOVQI2PQIrm %0, 1, $noreg, 0, $noreg {{.*}}(load (s64)
  ; CHECK-NEXT: %{{[0-9]+}}:vr128 = MOVHPSrm killed %[[LO]], %0, 1, $noreg, 8, $noreg {{.*}}(load (s64)
  ; UNCHANGED-LABEL: name: immediate_half
  ; UNCHANGED: %{{[0-9]+}}:vr128 = MOVUPSrm
  bb.0:
    liveins: $rdi, $rsi, $rdx
    %0:gr64 = COPY $rdi
    %1:gr64 = COPY $rsi
    MOV64mi32 %0, 1, $noreg, 8, $noreg, 7 :: (store (s64) into %ir.p + 8)
    %2:vr128 = MOVUPSrm %0, 1, $noreg, 0, $noreg :: (load (s128) from %ir.p, align 8)
    $xmm0 = COPY %2
    RET 0, $xmm0
...
---
name: both_halves
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: both_halves
  ; CHECK: %[[LO:[0-9]+]]:vr128 = MOVQI2PQIrm %0, 1, $noreg, 0, $noreg {{.*}}(load (s64)
  ; CHECK-NEXT: %{{[0-9]+}}:vr128 = MOVHPSrm killed %[[LO]], %0, 1, $noreg, 8, $noreg {{.*}}(load (s64)
  ; UNCHANGED-LABEL: name: both_halves
  ; UNCHANGED: %{{[0-9]+}}:vr128 = MOVUPSrm
  bb.0:

    %2:vr128 = VMOVDQUrm %0, 1, $noreg, 0, $noreg :: (load (s128) from %ir.p, align 8)
    $xmm0 = COPY %2
    RET 0, $xmm0
...
---
name: no_store
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: no_store
  ; CHECK-NOT: MOVQI2PQIrm
  ; CHECK: %{{[0-9]+}}:vr128 = MOVUPSrm
  ; CHECK-NOT: MOVHPSrm
  ; UNCHANGED-LABEL: name: no_store
  ; UNCHANGED: %{{[0-9]+}}:vr128 = MOVUPSrm
